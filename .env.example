APP_ENV=demo
LLM_ENABLED=false
INTERACTIVE_ENTRY_ENABLED=false
# Unified floating coach window (C3/C4). Off by default on purpose: the C0
# language fix must not depend on adopting the new entry, and the per-page
# coach drawer stays available as a fallback. Both keys must be enabled
# together, and VITE_* is inlined at build time so a rebuild is required.
# Quick try without touching defaults:
#   docker compose -f docker-compose.yml -f docker-compose.coach.yml up --build -d
COACH_CONVERSATIONS_ENABLED=false
VITE_COACH_CONVERSATIONS_ENABLED=false
ENTRY_TASK_TTL_DAYS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_RERANKER_PROVIDER=none
RAG_RERANKER_BASE_URL=
RAG_RERANKER_API_KEY=
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_CHUNK_OVERLAP_RATIO=0.15
RAG_CONTEXTUAL_PREFIX_MODE=deterministic
# Optional host data directory mounted into /app/data by Docker Compose
# (defaults to ./backend/data; set an external path such as %LOCALAPPDATA%\FitLifeAgent\data
# to separate runtime databases and user files from the Git repository).
FITLIFE_DATA_DIR=
POSTGRES_USER=fitlife
POSTGRES_PASSWORD=fitlife
POSTGRES_DB=fitlife
DATABASE_URL=postgresql://fitlife:fitlife@postgres:5432/fitlife
SETTINGS_ENCRYPTION_KEY=
FRONTEND_PORT=3000
BACKEND_PORT=8000
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120
PIP_RETRIES=5
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_BASE_URL=http://localhost:8000/api/v1
TELEMETRY_EXPORTER=none
OTEL_SERVICE_NAME=fitlife-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

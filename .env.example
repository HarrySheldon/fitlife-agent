APP_ENV=demo
LLM_ENABLED=false
INTERACTIVE_ENTRY_ENABLED=false
# Unified floating coach window (C3/C4). Off by default on purpose: the C0
# language fix must not depend on adopting the new entry, and the per-page
# coach drawer stays available as a fallback. Both keys must be enabled
# together, and VITE_* is inlined at build time so a rebuild is required.
# Quick try without touching defaults:
#   docker compose -f docker-compose.yml -f docker-compose.coach.yml up --build -d
COACH_CONVERSATIONS_ENABLED=false
VITE_COACH_CONVERSATIONS_ENABLED=false
ENTRY_TASK_TTL_DAYS=30
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
EMBEDDING_MODEL=text-embedding-3-small
SQLITE_DATABASE_PATH=
SETTINGS_ENCRYPTION_KEY=
FRONTEND_PORT=3000
BACKEND_PORT=8000
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=120
PIP_RETRIES=5
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_BASE_URL=http://localhost:8000
VITE_API_V1_BASE_URL=http://localhost:8000/api/v1

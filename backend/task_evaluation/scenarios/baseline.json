{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "entry-confirm",
      "version": 1,
      "initial_state": {
        "profile": {
          "height_cm": 175,
          "weight_kg": 70,
          "age": 30,
          "energy_parameter": "neutral",
          "activity_level": "moderate",
          "effective_from": "2026-01-01T00:00:00Z"
        }
      },
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts",
          "body": {
            "log_date": "2026-07-26",
            "raw_text": "早餐：白飯 100g\n力量：杠铃深蹲 3x8 60kg"
          },
          "capture": {"draft_id": "data.id", "version": "data.version"}
        },
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts/{draft_id}/confirm",
          "headers": {
            "If-Match": "{version}",
            "Idempotency-Key": "00000000-0000-0000-0000-000000000001"
          },
          "expected_status": 200,
          "capture": {"meal_ids": "data.meal_ids"}
        }
      ],
      "expected": {"confirmed_meals": 1, "confirmed_workouts": 1, "idempotency_count": 1}
    },
    {

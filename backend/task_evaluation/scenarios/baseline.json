          "headers": {
            "If-Match": "{version}",
            "Idempotency-Key": "33333333-3333-3333-3333-333333333333"
          },
          "expected_status": 410
        }
      ],
      "expected": {"confirmed_meals": 0, "confirmed_workouts": 0, "idempotency_count": 0}

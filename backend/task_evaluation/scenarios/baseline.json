    {
      "id": "cross-user-rejected",
      "version": 1,
      "initial_state": {
        "profile": {
          "height_cm": 175,
          "weight_kg": 70,
          "age": 30,
          "energy_parameter": "neutral",
          "activity_level": "moderate",
          "effective_from": "2026-01-01T00:00:00Z"
        },
        "authorization": {"additional_users": ["intruder"]}
      },
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts",
          "body": {
            "log_date": "2026-07-26",
            "raw_text": "早餐：白飯 100g"
          },
          "capture": {"draft_id": "data.id", "version": "data.version"}
        },
        {
          "actor": "intruder",
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts/{draft_id}/confirm",
          "headers": {
            "If-Match": "{version}",
            "Idempotency-Key": "22222222-2222-2222-2222-222222222222"
          },
          "expected_status": 404
        }
      ],
      "expected": {"confirmed_meals": 0, "actor.primary.confirmed_workouts": 0, "actor.primary.idempotency_count": 0, "actor.intruder.confirmed_meals": 0, "actor.intruder.confirmed_workouts": 0, "actor.intruder.draft_count": 0, "actor.intruder.idempotency_count": 0}
    },

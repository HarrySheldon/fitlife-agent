      "id": "coach-idempotent-owner-isolation",
      "version": 1,
      "requires": [
        "coach_conversations"
      ],
      "initial_state": {
        "authorization": {
          "additional_users": [
            "other"
          ]
        }
      },
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations",
          "body": {
            "title": "Synthetic"
          },
          "capture": {
            "chat": "data.conversation_id"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {
            "Idempotency-Key": "same-click"
          },
          "body": {
            "question": "Pick stocks"
          },
          "capture": {
            "turn": "data.turn_id"

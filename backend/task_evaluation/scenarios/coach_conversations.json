{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "coach-zh-boundary",
      "version": 1,
      "requires": [
        "coach_conversations"
      ],
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations",
          "body": {
            "title": "Synthetic"
          },
          "capture": {
            "chat": "data.conversation_id"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {
            "Idempotency-Key": "boundary-zh"
          },
          "body": {
            "question": "请推荐股票",
            "language": "zh-CN"
          },
          "capture": {
            "turn": "data.turn_id"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "wait_for_turn": true,
          "observe": {
            "terminal": "data.status",
            "answer_language": "data.receipt.context.language"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/conversations/{chat}/messages"
        }
      ],
      "expected": {
        "terminal": "succeeded",
        "answer_language": "zh-CN",
        "coach_boundary_replies": 1,
        "gateway_attempts": 0,
        "coach_turns": 1,
        "coach_successes": 1,
        "coach_messages": 2,
        "coach_unapproved_answers": 0,
        "confirmed_meals": 0,
        "confirmed_workouts": 0
      }
    },

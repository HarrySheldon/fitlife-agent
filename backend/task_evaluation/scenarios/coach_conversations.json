        },
        {
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "wait_for_turn": true
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {
            "Idempotency-Key": "same-click"
          },
          "body": {
            "question": "Pick stocks"
          },
          "observe": {
            "replayed": "data.replayed"
          }
        },
        {
          "actor": "other",
          "method": "GET",
          "path": "/api/v1/coach/conversations/{chat}/messages",
          "expected_status": 404
        },
        {
          "actor": "other",
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "expected_status": 404
        },
        {
          "actor": "other",
          "method": "POST",
          "path": "/api/v1/coach/turns/{turn}/cancel",
          "expected_status": 404
        }
      ],
      "expected": {
        "replayed": true,
        "gateway_attempts": 0,
        "coach_boundary_replies": 1,
        "coach_turns": 1,
        "coach_messages": 2,
        "actor.other.coach_messages": 0,
        "actor.other.coach_turns": 0,
        "confirmed_meals": 0,
        "confirmed_workouts": 0
      }
    },

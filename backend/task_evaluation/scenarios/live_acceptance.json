{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "live-normal-chest",
      "version": 1,
      "requires": [
        "coach_conversations",
        "unified_coach"
      ],
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations",
          "body": {
            "title": "Synthetic live evaluation"
          },
          "capture": {
            "chat": "data.conversation_id"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {
            "Idempotency-Key": "live-normal-chest"
          },
          "body": {
            "question": "教练你好，我需要今天练胸，给出一份完整的训练计划",
            "language": "zh-CN",
            "answer_mode": "detailed"
          },
          "capture": {
            "turn": "data.turn_id"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "wait_for_turn": true,
          "observe": {
            "terminal": "data.status"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/conversations/{chat}/messages",
          "observe": {
            "message_count": "data.messages.length"
          }
        }
      ],
      "expected": {
        "terminal": "succeeded",
        "message_count": 2
      }
    },

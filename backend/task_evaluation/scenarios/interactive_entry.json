{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "interactive-sufficient",
      "version": 1,
      "requires": [
        "interactive_entry"
      ],
      "initial_state": {
        "catalog": {
          "foods": [
            {
              "source_record_id": "s2-oats",
              "name": "S2wholemealOats",
              "calories": 380,
              "carbs": 60,
              "protein": 13,
              "fat": 7
            }
          ]
        }
      },
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts",
          "body": {
            "log_date": "2026-10-16",
            "raw_text": "早餐：S2wholemealOats 100g"
          },
          "capture": {
            "draft": "data.id",
            "v": "data.version"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts/{draft}/interaction/start",
          "headers": {
            "Idempotency-Key": "00000000-0000-0000-0000-000000000001"
          },
          "body": {
            "expected_version": {
              "$ref": "v"
            }
          },
          "capture": {
            "v": "data.version",
            "item": "data.payload.interaction.items.0.item_id",
            "rev": "data.payload.interaction.items.0.revision"
          },
          "observe": {
            "api_ready": "data.payload.interaction.items.0.state",
            "api_rounds": "data.payload.interaction.clarification_rounds"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/smart-entry-drafts/{draft}/confirm-items",
          "headers": {
            "Idempotency-Key": "00000000-0000-0000-0000-000000000002"
          },
          "body": {
            "expected_version": {
              "$ref": "v"
            },
            "selections": [
              {
                "item_id": {
                  "$ref": "item"
                },
                "item_revision": {
                  "$ref": "rev"
                }
              }
            ]
          },
          "capture": {
            "v": "data.remaining_draft_version"
          },
          "observe": {
            "api_saved_version": "data.remaining_draft_version"
          }
        }
      ],
      "expected": {
        "confirmed_workouts": 0,
        "api_ready": "ready",
        "api_rounds": 0,
        "api_saved_version": 3,
        "confirmed_meals": 1,
        "item_commit_count": 1,
        "saved_item_count": 1,
        "item_states": [
          "saved"
        ],
        "draft_versions": [
          3
        ]
      }
    },

    {
      "id": "perf-quick-action",
      "version": 1,
      "requires": [
        "coach_conversations",
        "unified_coach"
      ],
      "initial_state": {
        "faults": {
          "unified_decisions": [
            {
              "kind": "call",
              "call_id": "a",
              "tool": "resources.read",
              "arguments": {
                "resource_id": "skill:today-explanation"
              }
            },
            {
              "kind": "final",
              "body": "根据你的条件，可以先从固定频率的全身训练开始。"
            }
          ]
        }
      },
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations",
          "body": {
            "title": "Synthetic"
          },
          "capture": {
            "chat": "data.conversation_id"
          }
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {
            "Idempotency-Key": "perf-quick-action"
          },
          "body": {
            "question": "解释今天",
            "language": "zh-CN",
            "answer_mode": "brief",
            "action": "explain_today",
            "surface": "today",
            "date": "2026-10-19"
          },
          "capture": {
            "turn": "data.turn_id"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "wait_for_turn": true,
          "observe": {
            "terminal": "data.status"
          }
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/conversations/{chat}/messages",
          "observe": {
            "message_count": "data.messages.length"
          }
        }
      ],
      "expected": {
        "terminal": "succeeded",
        "coach_unapproved_answers": 0,
        "confirmed_meals": 0,
        "confirmed_workouts": 0,
        "message_count": 2
      }
    },

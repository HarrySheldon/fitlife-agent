{
  "schema_version": 1,
  "scenarios": [
    {
      "id": "boundary-mixed-separable",
      "version": 1,
      "requires": ["coach_conversations"],
      "steps": [
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations",
          "body": {"title": "Synthetic"},
          "capture": {"chat": "data.conversation_id"}
        },
        {
          "method": "POST",
          "path": "/api/v1/coach/conversations/{chat}/turns",
          "headers": {"Idempotency-Key": "boundary-mixed-separable"},
          "body": {
            "question": "两个互不相关的问题：帮我推荐股票；今天怎么训练",
            "language": "zh-CN"
          },
          "capture": {"turn": "data.turn_id"}
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/turns/{turn}",
          "wait_for_turn": true,
          "observe": {"terminal": "data.status"}
        },
        {
          "method": "GET",
          "path": "/api/v1/coach/conversations/{chat}/messages"
        }
      ],
      "expected": {
        "terminal": "succeeded",
        "coach_boundary_replies": 0,
        "coach_unapproved_answers": 0,
        "coach_successes": 1,
        "confirmed_meals": 0,
        "confirmed_workouts": 0
      }
    },
